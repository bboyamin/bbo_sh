# ==========================================
# LocalIssueNotifier 배포용 환경변수 템플릿
# ==========================================

# 1. 네이버 Open API 인증키 (필수: 뉴스 및 블로그 수집용)
NAVER_CLIENT_ID="YOUR_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET="YOUR_NAVER_CLIENT_SECRET"

# 2. 사내 FactChat Gateway API 설정
# 배포 시 사내 API 키는 기본적으로 공란 처리되며, 필요 시 서버 단위 기본키로 설정 가능합니다.
# 사용자는 앱 내 [⚙️ 설정] 화면에서 본인 개별 API 키를 등록하여 사용합니다.
FACTCHAT_API_KEY=""
FACTCHAT_BASE_URL="https://factchat-cloud.mindlogic.ai/v1/gateway"

# 3. 서버 포트 설정
PORT=8080
